# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- language model -----------------------------------------------------------
# demo.py answers on a hosted endpoint by default. Set LABGPT_BACKEND=local to answer on
# a local transformers model (LABGPT_MODEL) instead. The labrag CLI always calls an
# endpoint; it has no local-model path.
LABGPT_BACKEND=
# Optional, reasoning deployments only: minimal | low | medium | high
LABGPT_REASONING_EFFORT=

# Two providers. chat_client_from_env prefers Azure whenever its variables are set, so on
# a machine configured for both, the institutional endpoint wins by default and data
# cannot reach a personal key because an argument was forgotten.

# Any OpenAI-compatible /v1 endpoint: the OpenAI API, a self-hosted vLLM, Ollama, or a
# proxy. base_url is what selects between them.
LABGPT_LLM_API_KEY=
LABGPT_LLM_BASE_URL=https://api.openai.com/v1
LABGPT_LLM_MODEL=

# Azure OpenAI, direct or behind an API Management gateway. Give the base URL either
# way. Two ways to write it, and one of them is enough:
#
#   AZURE_OPENAI_ENDPOINT   the whole base, used as given
#                             e.g. https://<gateway-host>/<product>/<team-id>
#                             or   https://<resource>.openai.azure.com
#
#   AZURE_OPENAI_GATEWAY    the host and product path, with the team id appended from
#   AZURE_OPENAI_TEAM_ID    AZURE_OPENAI_TEAM_ID, which is how the institutional Azure
#                           snippet builds its azure_endpoint
#
# The deployment path and api-version are appended by the client, so a base that already
# carries /openai/deployments/... is trimmed back rather than doubled. A base missing the
# team segment is the usual cause of a 401 saying "invalid subscription key or wrong API
# endpoint": the gateway matched no product, which reads like a bad key.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_GATEWAY=
AZURE_OPENAI_TEAM_ID=
AZURE_OPENAI_MODEL_ID=
AZURE_OPENAI_API_VERSION=
APIM_OPENAI_SUBSCRIPTION_KEY=

# --- embeddings ---------------------------------------------------------------
# The index is built by BAAI/bge-small-en-v1.5, downloaded once from huggingface.co and
# cached. Set this to a directory holding that model instead, for machines on a network
# that blocks the hub. It must be the same model the index was built with.
LABGPT_EMBED_MODEL=
