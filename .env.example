# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Google Custom Search, used by search/callGoogleAPI.py
# Create a key at https://console.cloud.google.com/apis/credentials
# and a search engine at https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# --- language model -----------------------------------------------------------
# Two providers. chat_client_from_env prefers Azure whenever AZURE_OPENAI_ENDPOINT is
# set, so on a machine configured for both, the institutional endpoint wins by default
# and data cannot reach a personal key because an argument was forgotten.

# OpenAI, or any OpenAI-compatible endpoint (vLLM, Ollama, a LiteLLM proxy).
LABGPT_LLM_API_KEY=
LABGPT_LLM_BASE_URL=https://api.openai.com/v1
LABGPT_LLM_MODEL=

# Azure OpenAI. ENDPOINT is the whole base URL, not assembled from parts: behind an API
# Management gateway the route carries a path segment identifying the team or product,
# and that segment belongs here with the host.
#   e.g. https://<your-gateway-host>/<path>/<team-id>
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL_ID=
AZURE_OPENAI_API_VERSION=
APIM_OPENAI_SUBSCRIPTION_KEY=
