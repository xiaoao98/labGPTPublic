# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Google Custom Search, used by search/callGoogleAPI.py
# Create a key at https://console.cloud.google.com/apis/credentials
# and a search engine at https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# --- language model -----------------------------------------------------------
# Any OpenAI-compatible /v1 endpoint: the OpenAI API, a self-hosted vLLM, Ollama, or a
# proxy. base_url is what selects between them.
LABGPT_LLM_API_KEY=
LABGPT_LLM_BASE_URL=https://api.openai.com/v1
LABGPT_LLM_MODEL=
