# Secrets. Never commit these.
.env
.env.*
!.env.example
*.key
credentials.json
service-account*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Local model and data caches
.cache/
*.log

# Databases. The .db files already committed stay tracked (gitignore does not
# affect tracked paths); this only stops new ones. To untrack the existing set,
# see the review notes on `git rm --cached`.
*.db
*.sqlite
*.sqlite3
metrics*.jsonl

# Generated retrieval indexes. Rebuild with: python -m labrag.cli --index-dir DIR index
#
# Globbed rather than listed. Each index was added by name as it appeared and each time
# the next one was missed: .index-eval went untracked-by-accident once, and .index-lab
# sat uncommitted holding 12 MB of a private corpus verbatim. An index is a copy of
# whatever it was built from, so the default has to be exclusion.
.index*/

# Fetched evaluation corpus. Rebuild with tools/fetch_eval_corpus.py
# Not committed: several sources are CC BY-NC-ND.
data/eval/*
!data/eval/manifest.json

# Private laboratory corpus for the head-to-head comparison against the old system.
# Real protocols, reagents, members and publications; never committed.
data/eval_lab/

# The question set built over that corpus. Excluded for the same reason the corpus is:
# each question carries a note recording the answer it was labeled against, so the file
# is a few hundred short extracts from the private documents even though it holds none
# of them whole. eval/questions.yaml stays tracked; its corpus is published protocols.
eval/questions_lab.yaml
